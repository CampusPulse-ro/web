# Normalize line endings: LF in the repo and in every checkout, Windows included.
* text=auto eol=lf

# Binary files: never touch them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Generated by `bun run api:types`: collapsed in GitHub diffs, never edited by hand.
src/api/openapi.json linguist-generated=true
src/api/schema.d.ts linguist-generated=true
